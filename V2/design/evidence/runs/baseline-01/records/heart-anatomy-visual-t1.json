    "scope": {
      "covered_count": 25,
      "covered": [
        {
          "concept": "Pericardium and heart position",
          "depth": "work through",
          "anticipates": "perceptual-referent",
          "why": "Must label pericardial layers, sinuses, and heart position in mediastinum diagrams; tested in every NEET cycle."
        },
        {
          "concept": "External heart features and sulci",
          "depth": "work through",
          "anticipates": "perceptual-referent",
          "why": "Sulci (coronary, interventricular) and external landmarks (auricles, borders) are standard labeling items in anterior/posterior view diagrams."
        },
        {
          "concept": "Right atrium internal anatomy",
          "depth": "work through",
          "anticipates": "perceptual-referent",
          "why": "High-yield structures (fossa ovalis, SA node, IVC/SVC/coronary sinus openings, crista terminalis, pectinate muscles) appear in internal view labeling questions."
        },
        {
          "concept": "Right ventricle internal anatomy",
          "depth": "work through",
          "anticipates": "perceptual-referent",
          "why": "Trabeculae carneae, papillary muscles (anterior/posterior/septal), moderator band, and pulmonary valve are tested in cross-section and internal view diagrams."
        },
        {
          "concept": "Left atrium internal anatomy",
          "depth": "work through",
          "anticipates": "perceptual-referent",
          "why": "Four pulmonary vein openings, mitral valve orifice, and smooth vs. rough wall distinction are standard labeling targets."
        },
        {
          "concept": "Left ventricle internal anatomy",
          "depth": "work through",
          "anticipates": "perceptual-referent",
          "why": "Aortic vestibule, papillary muscles (anterolateral/posteromedial), thick wall, and trabeculae are tested in diagrams and wall-thickness comparison questions."
        },
        {
          "concept": "Tricuspid valve apparatus",
          "depth": "work through",
          "anticipates": "perceptual-referent",
          "why": "Three cusps (anterior/posterior/septal), chordae tendineae, and papillary muscle connections must be labeled in valve apparatus diagrams."
        },
        {
          "concept": "Pulmonary valve",
          "depth": "work through",
          "anticipates": "perceptual-referent",
          "why": "Semilunar valve structure (three cusps), location at pulmonary trunk origin, and absence of chordae are diagram staples."
        },
        {
          "concept": "Mitral valve apparatus",
          "depth": "work through",
          "anticipates": "perceptual-referent",
          "why": "Two cusps (anterior/posterior), chordae, and two papillary muscles are high-yield for labeling and distinguishing from tricuspid."
        },
        {
          "concept": "Aortic valve",
          "depth": "work through",
          "anticipates": "perceptual-referent",
          "why": "Three semilunar cusps (right/left/posterior), coronary ostia origins, and aortic sinuses are tested in diagrams and clinical correlate questions."
        },
        {
          "concept": "Fibrous skeleton of heart",
          "depth": "explain",
          "anticipates": "none",
          "why": "Annuli fibrosi anchor valves and provide electrical insulation; theory MCQs test its role in separating atrial/ventricular conduction."
        },
        {
          "concept": "Systemic venous return vessels",
          "depth": "work through",
          "anticipates": "perceptual-referent",
          "why": "SVC, IVC, and coronary sinus openings into RA are fundamental for blood flow tracing and posterior heart labeling."
        },
        {
          "concept": "Pulmonary arterial trunk and branches",
          "depth": "work through",
          "anticipates": "perceptual-referent",
          "why": "Pulmonary trunk bifurcation into left/right pulmonary arteries is a key flow pathway step and labeling item in anterior views."
        },
        {
          "concept": "Pulmonary veins",
          "depth": "work through",
          "anticipates": "perceptual-referent",
          "why": "Four pulmonary veins entering LA (two left, two right) tested in labeling and flow sequence questions."
        },
        {
          "concept": "Aorta and major branches",
          "depth": "work through",
          "anticipates": "perceptual-referent",
          "why": "Ascending aorta, arch, and three major branches (brachiocephalic, left common carotid, left subclavian) appear in diagrams and flow tracing."
        },
        {
          "concept": "Coronary arterial supply",
          "depth": "work through",
          "anticipates": "perceptual-referent",
          "why": "RCA, LCA, LAD, LCX dominance patterns and supply areas are high-yield theory and occasional diagram items; clinical correlates depend on this."
        },
        {
          "concept": "Coronary venous drainage",
          "depth": "work through",
          "anticipates": "perceptual-referent",
          "why": "Coronary sinus drainage into RA is a specific labeling point in posterior/inferior heart views."
        },
        {
          "concept": "Systemic-to-pulmonary blood flow sequence",
          "depth": "work through",
          "anticipates": "topology",
          "why": "Core competency: tracing deoxygenated → oxygenated pathway through all chambers, valves, and vessels is the primary stated target capability."
        },
        {
          "concept": "Cardiac conducting system components",
          "depth": "explain",
          "anticipates": "perceptual-referent",
          "why": "SA node, AV node, Bundle of His, bundle branches, Purkinje fiber locations and functions are standard theory and occasional diagram items."
        },
        {
          "concept": "Cardiac cycle phases and pressure changes",
          "depth": "explain",
          "anticipates": "parallel-state",
          "why": "Pressure-volume loops, valve open/close timing, and phase definitions (isovolumetric contraction/relaxation, ejection, filling) are high-yield theory for NEET."
        },
        {
          "concept": "Heart sounds and valve events",
          "depth": "explain",
          "anticipates": "none",
          "why": "S1/S2 correlation with AV and semilunar valve closure tested in theory MCQs; links to cardiac cycle phases."
        },
        {
          "concept": "ECG waves and conduction events",
          "depth": "explain",
          "anticipates": "none",
          "why": "P wave, QRS complex, T wave correlation with atrial/ventricular depolarization/repolarization is standard theory."
        },
        {
          "concept": "Cardiac output and hemodynamic parameters",
          "depth": "explain",
          "anticipates": "none",
          "why": "CO = HR × SV, stroke volume, ejection fraction definitions appear in numerical and conceptual MCQs."
        },
        {
          "concept": "Autonomic regulation of heart rate and contractility",
          "depth": "explain",
          "anticipates": "none",
          "why": "Sympathetic/parasympathetic effects on SA/AV nodes and contractility are theory staples; mechanism questions appear regularly."
        },
        {
          "concept": "Common clinical correlates for NEET",
          "depth": "mention",
          "anticipates": "none",
          "why": "Heart blocks, murmurs, coronary artery occlusion patterns tested as application MCQs; high-yield facts only, not deep pathophysiology."
        }
      ],
