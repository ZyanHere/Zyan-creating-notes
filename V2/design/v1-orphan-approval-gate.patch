+def test_approval_refuses_a_plan_that_strands_a_concept(tmp_path) -> None:
+    """The regression. A concept in `scope` and in no module is unwritable, so
+    the gate refuses rather than committing a promise it cannot keep."""
+    stranding = copy.deepcopy(PLAN)
+    stranding["scope"]["covered"].append(
+        {
+            "concept": "Molecular clocks",
+            "depth": "explain",
+            "why": "Dating the splits.",
+            "anticipates": "none",
+        }
+    )
+    service = PlanService(
+        FileStore(tmp_path),
+        provider=StubProvider(READING_SUFFICIENT, LANDSCAPE, stranding),
+    )
+    view = opened(service)
+
+    with pytest.raises(PlanNotApprovable) as refused:
+        service.approve(view.project_id)
+
+    assert refused.value.unassigned.orphans == ("Molecular clocks",)
+    assert "Molecular clocks" in str(refused.value)
+    assert not service.store.commitments(view.project_id), (
+        "a refused approval must not leave a commitment behind"
+    )
+
