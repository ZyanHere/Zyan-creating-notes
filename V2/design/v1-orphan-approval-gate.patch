+class PlanNotApprovable(Exception):
+    """The gate refuses: this plan does not hold together.
+
+    Approval is the point where the system takes on the promise that what gets
+    written is what was read. A plan with a stranded concept cannot keep that
+    promise -- and worse, fails it silently, because nothing downstream is
+    answerable for a concept in no module. See `agent.curriculum.unassigned`.
+
+    Refused rather than repaired. Placing the concept is a partition decision,
+    and a gate that quietly edits the plan it was asked to approve is the
+    failure this whole stage exists to prevent.
+    """
+
+    def __init__(self, stranded: Unassigned) -> None:
+        self.unassigned = stranded
+        parts: list[str] = []
+        if stranded.orphans:
+            parts.append(
+                f"{len(stranded.orphans)} approved concept(s) belong to no module, "
+                "so nothing would write them: " + ", ".join(stranded.orphans)
+            )
+        if stranded.phantoms:
+            parts.append(
+                f"{len(stranded.phantoms)} concept(s) are named by a module but are "
+                "not in scope, so they would be listed and never written: "
+                + ", ".join(stranded.phantoms)
+            )
+        super().__init__(
+            ". ".join(parts)
+            + ". Correct the plan -- say where they belong, or that they should be "
+            "cut -- and approve again."
+        )
+
+
