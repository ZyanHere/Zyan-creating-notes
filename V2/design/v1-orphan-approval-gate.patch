+    service.provider = StubProvider(routing(["partition"], partition=placed))
+    service.correct(view.project_id, "put molecular clocks with the hominins")
+
+    commitment = service.approve(view.project_id)
+    assert commitment.snapshot["partition"]["modules"][1]["covers"] == [
