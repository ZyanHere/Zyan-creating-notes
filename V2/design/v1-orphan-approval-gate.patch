+@dataclass(frozen=True, slots=True)
+class Unassigned:
+    """Concepts the plan promises that no module will write, and the reverse."""
+
+    orphans: tuple[str, ...] = ()
+    """In `scope.covered`, in no module's `covers`. Approved and never written."""
+
+    phantoms: tuple[str, ...] = ()
+    """Named by a module, absent from `scope.covered`. Listed and never written."""
+
+    def __bool__(self) -> bool:
+        return bool(self.orphans or self.phantoms)
+
+    def to_json(self) -> dict:
+        return {"orphans": list(self.orphans), "phantoms": list(self.phantoms)}
+
+
+def unassigned(plan: dict | None) -> Unassigned:
+    """Whether every approved concept has a module answerable for it.
+
+    The failure this exists for is silent and survived every check the system
+    had. A correction adds a concept to `scope` without placing it in a module.
+    The plan page shows it -- `compose.ts` surfaces it under "Also covered" --
+    and the user approves it. `derive_extent` counts its pages into the size
+    they agreed to. Then `modules()` reads `partition.modules` and nothing else,
+    so the concept is in no module, no module is answerable for it, and
+    `check_document` -- which runs per module against that module's narrowed
+    plan -- never sees it to report it missing. Every surface reports satisfied
+    and the concept is simply not in the artifact.
+
+    `phantoms` is the same fault mirrored: a module names a concept that `scope`
+    does not carry, so `plan_for` drops it while the module still lists it to
+    the reader as something it covers.
+
+    Reported, never repaired. Placing a stranded concept would be a partition
+    decision, and this layer must not make one.
+    """
+    partition = (plan or {}).get("partition") or {}
+    approved = partition.get("modules") or []
+    if not approved:
+        # Legacy `units` plans and plans with no partition resolve to a single
+        # module covering the whole scope (see `modules`), so nothing can be
+        # stranded. Refusing them would refuse every project written before the
+        # curriculum layer, which is the one thing the legacy path exists for.
+        return Unassigned()
+
+    covered = [
+        c["concept"]
+        for c in ((plan or {}).get("scope") or {}).get("covered", [])
+        if isinstance(c, dict) and c.get("concept")
+    ]
+    placed = {c for m in approved for c in (m.get("covers") or [])}
+
+    return Unassigned(
+        # Scope order, because that is the model's own priority ordering.
+        orphans=tuple(c for c in covered if c not in placed),
+        phantoms=tuple(sorted(placed - set(covered))),
+    )
+
+
