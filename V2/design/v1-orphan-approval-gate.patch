+    stranding = copy.deepcopy(PLAN)
+    stranding["scope"]["covered"].append(
+        {"concept": "Molecular clocks", "depth": "explain", "why": "Dating.",
+         "anticipates": "none"}
+    )
+    service = PlanService(
+        FileStore(tmp_path),
