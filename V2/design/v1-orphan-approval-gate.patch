+def test_every_approved_concept_has_a_module_answerable_for_it(
+    service: PlanService,
+) -> None:
+    """The promise, stated as an invariant over the approved snapshot.
+
+    What the plan says is covered must be exactly what the modules will write.
+    Anything in `scope` that no module claims is approved, counted into the
+    extent, shown on the plan page, and then written by nobody -- and because
+    fulfilment runs per module against that module's narrowed plan, nothing
+    reports it missing. Every surface says satisfied and the concept is absent.
+    """
+    view = opened(service)
+    snapshot = service.approve(view.project_id).snapshot
+
+    approved = {c["concept"] for c in snapshot["scope"]["covered"]}
+    will_be_written = {
+        c["concept"]
+        for module in curriculum.modules(snapshot)
+        for c in curriculum.plan_for(snapshot, module.index)["scope"]["covered"]
+    }
+    assert will_be_written == approved
