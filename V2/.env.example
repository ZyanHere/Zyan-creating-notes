# Copy to `.env`. Never commit `.env`.
#
# Every variable here is read by config.py and validated at import, so a typo stops
# the process with a sentence naming the field rather than failing forty seconds into
# a plan turn.

# local | ci | staging | production
# Anything other than `local` makes config.require_production_ready() enforce the
# three checks below before the server binds.
APP_ENV=local

# ── database ──────────────────────────────────────────────────────────────────────
# Validated as a real DSN. `make db` starts a matching local Postgres.
DB_URL=postgresql://postgres:postgres@localhost:5432/mynotes_v2
DB_POOL_SIZE=20

# ── provider ──────────────────────────────────────────────────────────────────────
# Required outside local. The backend refuses to start a non-local server without it.
PROVIDER_API_KEY=
PROVIDER_BASE_URL=https://openrouter.ai/api/v1

# Pinned into every derivation environment — changing it changes identity, so a
# committed plan records which model produced it.
PROVIDER_MODEL_ID=nvidia/nemotron-3-ultra-550b-a55b:free

# Per-ATTEMPT ceiling, not per Task. The Task budget bounds the total.
PROVIDER_ATTEMPT_DEADLINE_S=120

# Concurrent provider calls, acquired as a FIFO slot in MODEL_CALL.
PROVIDER_CONCURRENCY=8

# Per fixed UTC hour, per tenant, enforced at admission.
PROVIDER_TENANT_CALLS_PER_HOUR=200

# ── server ────────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# A plan turn runs for minutes. Not a tuning knob.
TIMEOUT_KEEP_ALIVE=900

# Comma-separated. Must not contain localhost outside APP_ENV=local.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── access ────────────────────────────────────────────────────────────────────────
# A shared code is NOT auth. It stops a public URL draining the quota; nothing more.
# Required outside local.
ACCESS_CODE=
