        {
          "concept": "Graph Representation (Adjacency List)",
          "depth": "explain",
          "anticipates": "perceptual-referent",
          "why": "Default sparse representation; must know structure, space O(V+E), iteration pattern, and when to prefer over matrix."
        },
        {
          "concept": "Graph Representation (Adjacency Matrix)",
          "depth": "explain",
          "anticipates": "perceptual-referent",
          "why": "Dense graphs and O(1) edge lookup; must know space O(V²), Floyd-Warshall dependency, and tradeoff vs list."
        },
        {
          "concept": "Graph Representation (Edge List)",
          "depth": "mention",
          "anticipates": "none",
          "why": "Compact O(E) form needed for Kruskal and Bellman-Ford; one-line note with use cases suffices."
        },
        {
          "concept": "BFS Traversal",
          "depth": "explain",
          "anticipates": "topology",
          "why": "Foundation for unweighted shortest path, topological sort (Kahn's), multi-source, grid problems. Needs queue pattern, visited handling, level-order loop, complexity."
        },
        {
          "concept": "DFS Traversal (Recursive)",
          "depth": "explain",
          "anticipates": "topology",
          "why": "Foundation for cycle detection (directed), topological sort (DFS), SCC, backtracking. Needs recursion pattern, visited states, call stack awareness, complexity."
        },
        {
          "concept": "DFS Traversal (Iterative)",
          "depth": "explain",
          "anticipates": "procedure-execution",
          "why": "Avoids recursion depth limits; explicit stack control. Distinct template some interviewers request. Same complexity, different mechanics."
        },
        {
          "concept": "Connected Components (Undirected)",
          "depth": "explain",
          "anticipates": "topology",
          "why": "Directly tested (Number of Islands, provinces); template applies to grids and explicit graphs. Must show BFS/DFS driver loop."
        },
        {
          "concept": "Cycle Detection (Undirected Graph)",
          "depth": "explain",
          "anticipates": "topology",
          "why": "Two standard approaches: DFS with parent tracking, and Union-Find. Must distinguish from directed case. High-frequency (redundant connection, valid tree)."
        },
        {
          "concept": "Cycle Detection (Directed Graph)",
          "depth": "explain",
          "anticipates": "topology",
          "why": "Three-color DFS (white/gray/black) or Kahn's indegree check. Course schedule, deadlock detection. Distinct from undirected — cannot reuse parent-tracking."
        },
        {
          "concept": "Bipartite Graph Check",
          "depth": "explain",
          "anticipates": "topology",
          "why": "BFS/DFS coloring template (two-color). Standalone question and matching subroutine. Short, high-yield, must-recognize pattern."
        },
        {
          "concept": "Topological Sort (Kahn's Algorithm / BFS)",
          "depth": "explain",
          "anticipates": "topology",
          "why": "Most common interview topological sort (Course Schedule I/II). Queue + indegree, natural cycle detection. Template essential."
        },
        {
          "concept": "Topological Sort (DFS-based)",
          "depth": "explain",
          "anticipates": "topology",
          "why": "Post-order DFS + reverse. Useful when lexicographic order needed (Alien Dictionary). Good to contrast with Kahn's."
        },
        {
          "concept": "Shortest Path: Unweighted (BFS)",
          "depth": "explain",
          "anticipates": "procedure-execution",
          "why": "Foundation for grid/maze shortest path, multi-source, 0-1 BFS. Simpler than Dijkstra; often sufficient. Distance array + parent for reconstruction."
        },
        {
          "concept": "Dijkstra's Algorithm",
          "depth": "explain",
          "anticipates": "cross-reference",
          "why": "Single-source, non-negative weights. Priority queue + relaxation. High-frequency (Network Delay Time). Early exit and path reconstruction variants."
        },
        {
          "concept": "Bellman-Ford Algorithm",
          "depth": "explain",
          "anticipates": "cross-reference",
          "why": "Handles negative weights, detects negative cycles. O(VE). Cheapest Flights Within K Stops is constrained variant. Template worth including for comparison."
        },
        {
          "concept": "Floyd-Warshall Algorithm",
          "depth": "explain",
          "anticipates": "cross-reference",
          "why": "All-pairs shortest path, O(V³). Adjacency matrix based. Small template, appears in 'minimum score of path between two cities' problems."
        },
        {
          "concept": "Minimum Spanning Tree: Prim's Algorithm",
          "depth": "explain",
          "anticipates": "cross-reference",
          "why": "MST for dense graphs or node-start. Priority queue similar to Dijkstra. Connecting cities, min cost to connect all points. Contrast with Kruskal."
        },
        {
          "concept": "Minimum Spanning Tree: Kruskal's Algorithm",
          "depth": "explain",
          "anticipates": "cross-reference",
          "why": "MST for sparse graphs; relies on Union-Find. Sort edges + union. Classic interview problem. Must know Union-Find first."
        },
        {
          "concept": "Union-Find / Disjoint Set Union",
          "depth": "explain",
          "anticipates": "procedure-execution",
          "why": "Standalone data structure powering Kruskal, cycle detection (undirected), dynamic connectivity. Path compression + union by rank template is mandatory."
        },
        {
          "concept": "BFS Template Pattern",
          "depth": "work through",
          "anticipates": "procedure-execution",
          "why": "Copy-pasteable template: queue, visited, level-order loop. Highest ROI for interview recall. Must show generic structure + grid adaptation."
        },
        {
          "concept": "DFS Template Pattern (Recursive)",
          "depth": "work through",
          "anticipates": "procedure-execution",
          "why": "Standard recursive pattern with visited set. Used for components, cycle detection, topological sort, backtracking. Generic + grid variants."
        },
        {
          "concept": "DFS Template Pattern (Iterative)",
          "depth": "work through",
          "anticipates": "procedure-execution",
          "why": "Explicit stack version; avoids recursion limit. Some interviewers prefer it. Compact enough to include both."
        },
        {
          "concept": "Dijkstra Template Pattern",
          "depth": "work through",
          "anticipates": "procedure-execution",
          "why": "Priority queue + distance map + relaxation. Variations: early exit, path reconstruction. Must-have template for weighted graphs."
        },
        {
          "concept": "Union-Find Template Pattern",
          "depth": "work through",
          "anticipates": "procedure-execution",
          "why": "Find with path compression, union by rank/size. Used in 5+ common problems. One of the highest-value templates."
        },
