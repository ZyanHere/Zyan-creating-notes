# Copy to .env and fill in. .env is gitignored.
#
# Free default -- openrouter.ai/keys. ~50 documents/day, no data-for-training.
# That daily budget is account-wide across every :free model, so a 429 here
# is not fixed by switching to another free slug.
OPENROUTER_API_KEY=

# The real target. ~40c per document on claude-opus-5.
# ANTHROPIC_API_KEY=

# PROVIDER=openrouter
# MODEL=openai/gpt-oss-120b:free
# MAX_OUTPUT_TOKENS=32000
