# Copy this file to .env and fill in values as needed for local development.

# OpenRouter is OpenAI-API compatible: one client, any model.
# Free keys: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Any model id from https://openrouter.ai/models — ":free" variants cost nothing.
# Which models are free changes without notice, and free tiers share an upstream
# rate-limit pool, so expect the occasional 429. List today's free ids with:
#   GET https://openrouter.ai/api/v1/models   → ids ending in ":free"
#
# Free models rarely support strict JSON-schema mode, so the agent validates
# and retries rather than trusting the provider to enforce the shape.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

AGENT_ENV=development
LOG_LEVEL=INFO
