<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ doc.title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=IBM+Plex+Mono:wght@400;600&display=swap">
<style>
  /* A third template. Semantics §2: a template constrains presentation, never
     content -- the same Document renders here and in study-notes, and neither
     may change what it says.

     Its reason for existing is that it is as far from the other two as the
     block vocabulary allows: dark ground, amber ink, serif body, and a
     geometric display face. If a Document survives all three intact, the
     agent/engine separation is real rather than asserted. */

  :root {
    --ground:    #0b0b0d;
    --panel:     #131318;
    --panel-2:   #17161c;
    --yellow:    #ffd23f;
    --orange:    #ff8c1a;
    --amber-dim: #c9973c;
    --body:      #f0e6d2;   /* warm off-white: yellow family, still readable at 10pt */
    --muted:     #8c8272;
    --rule:      #2b2822;
    --rule-lit:  #4a3f22;
  }

  /* Full bleed on EVERY page, which a dark template needs and Chromium does
     not give away. Three approaches were measured and two failed:

       @page margins + body background  -> margin area stays paper-white
       position:fixed full-bleed layer  -> clipped to the content box (as
                                           module-guide already records)
       header/footer templates          -> Chromium does not print their
                                           backgrounds

     What works is a page margin of zero -- so the body's ground reaches the
     paper edge -- with the vertical rhythm carried by a table thead/tfoot,
     which Chromium repeats on every printed page. The horizontal rhythm is
     ordinary padding on the cell. This is the second recorded cost of System
     Design §3 choosing Chromium; the first was cosmetic, this one is visible
     on every page. */
  @page {
    size: A4;
    margin: 0;
  }

  * { box-sizing: border-box; }

  /* Chromium will not propagate a background into the @page margin area, so
     the ground is painted by a body background plus per-page bleed on the
     cover, exactly as module-guide documents. Everything here needs
     print_background, which render_pdf already sets. */
  html, body { margin: 0; padding: 0; background: var(--ground); }

  body {
    font-family: "Source Serif 4", Georgia, serif;
    font-size: 10.4pt;
    line-height: 1.62;
    color: var(--body);
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  p { margin: 0 0 3.4mm; }
  strong { color: var(--yellow); font-weight: 600; }
  code {
    font-family: "IBM Plex Mono", monospace;
    font-size: .88em;
    color: var(--orange);
    background: #1c1a15;
    padding: .4mm 1.2mm;
    border-radius: .8mm;
  }

  /* ---------------- cover ---------------- */

  .cover {
    position: relative;
    height: 297mm;
    padding: 30mm 19mm 16mm;
    background:
      radial-gradient(120% 80% at 12% 0%, #1e1a10 0%, rgba(11,11,13,0) 62%),
      radial-gradient(90% 60% at 100% 100%, #241606 0%, rgba(11,11,13,0) 58%),
      var(--ground);
    overflow: hidden;
  }
  .cover .grid {
    position: absolute; inset: 0; width: 100%; height: 100%;
  }
  .cover .content { position: relative; }
  .cover .eyebrow {
    font-family: "IBM Plex Mono", monospace;
    font-size: 8.4pt; letter-spacing: .3em; text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 5mm;
  }
  .cover h1 {
    font-family: "Space Grotesk", "Segoe UI", sans-serif;
    font-size: 42pt; font-weight: 700; line-height: 1.02;
    letter-spacing: -.025em;
    color: var(--yellow);
    margin: 0 0 7mm;
  }
  .cover h1 .tail { color: var(--orange); }
  .cover .subtitle {
    font-size: 13pt; line-height: 1.55; color: var(--body);
    margin: 0 0 12mm; max-width: 130mm;
  }
  .cover .chips { display: flex; flex-wrap: wrap; gap: 3mm; margin-bottom: 12mm; }
  .cover .chip {
    font-family: "IBM Plex Mono", monospace;
    font-size: 8.4pt;
    padding: 2.2mm 3.8mm;
    border: .3mm solid var(--rule-lit);
    border-radius: 1.2mm;
    color: var(--yellow);
    background: rgba(255,210,63,.05);
    white-space: nowrap;
  }
  .cover .notes {
    font-family: "IBM Plex Mono", monospace;
    font-size: 9pt; line-height: 1.9; color: var(--muted);
  }
  .cover .footer { position: absolute; left: 19mm; right: 19mm; bottom: 14mm; }
  .cover .footer .rule {
    height: .5mm; margin-bottom: 4mm;
    background: linear-gradient(90deg, var(--yellow), var(--orange) 45%, rgba(255,140,26,0) 100%);
  }
  .cover .footer .row {
    display: flex; justify-content: space-between;
    font-family: "IBM Plex Mono", monospace;
    font-size: 8pt; letter-spacing: .18em; text-transform: uppercase;
    color: var(--muted);
  }

  /* ---------------- page furniture ---------------- */

  table.sheet { width: 100%; border-collapse: collapse; }
  table.sheet > thead > tr > td { height: 17mm; padding: 0; border: 0; }
  table.sheet > tfoot > tr > td { height: 15mm; padding: 0; border: 0; }
  table.sheet > tbody > tr > td { padding: 0 19mm; border: 0; vertical-align: top; }

  .runhead {
    display: flex; justify-content: space-between;
    font-family: "IBM Plex Mono", monospace;
    font-size: 7.6pt; letter-spacing: .22em; text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 2.4mm;
    border-bottom: .25mm solid var(--rule);
    margin-bottom: 7mm;
  }

  .orient {
    border-left: .8mm solid var(--orange);
    background: var(--panel);
    padding: 4.5mm 5mm;
    margin-bottom: 9mm;
    break-inside: avoid;
  }
  .orient .row { display: flex; gap: 5mm; margin-bottom: 2.4mm; }
  .orient .row:last-child { margin-bottom: 0; }
  .orient .k {
    flex: 0 0 26mm;
    font-family: "IBM Plex Mono", monospace;
    font-size: 7.4pt; letter-spacing: .16em; text-transform: uppercase;
    color: var(--orange);
    padding-top: .8mm;
  }
  .orient .v { flex: 1; font-size: 9.6pt; color: var(--body); }

  section { margin-bottom: 9mm; }

  .eyebrow-s {
    font-family: "IBM Plex Mono", monospace;
    font-size: 7.6pt; letter-spacing: .26em; text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 2mm;
  }
  h2 {
    font-family: "Space Grotesk", "Segoe UI", sans-serif;
    font-size: 19pt; font-weight: 700; line-height: 1.14;
    letter-spacing: -.015em;
    color: var(--yellow);
    margin: 0 0 4.5mm;
    padding-bottom: 2.6mm;
    border-bottom: .3mm solid var(--rule-lit);
    break-after: avoid;
  }
  h2 .tail { color: var(--orange); }

  .subhead {
    font-family: "IBM Plex Mono", monospace;
    font-size: 8pt; font-weight: 600;
    letter-spacing: .2em; text-transform: uppercase;
    color: var(--amber-dim);
    margin: 6mm 0 2.4mm;
    break-after: avoid;
  }
  h3 {
    font-family: "Space Grotesk", "Segoe UI", sans-serif;
    font-size: 12pt; font-weight: 500;
    color: var(--orange);
    margin: 6mm 0 2.4mm;
    break-after: avoid;
  }

  .body-chips { display: flex; flex-wrap: wrap; gap: 2.4mm; margin: 0 0 5mm; }
  .body-chips .chip {
    font-family: "IBM Plex Mono", monospace;
    font-size: 7.6pt;
    padding: 1.5mm 2.8mm;
    border: .25mm solid var(--rule-lit);
    border-radius: 1mm;
    color: var(--amber-dim);
  }

  ul, ol { margin: 0 0 4mm; padding-left: 6mm; }
  li { margin-bottom: 1.8mm; }
  li::marker { color: var(--orange); }

  /* ---------------- figures ---------------- */

  figure { margin: 0 0 6mm; break-inside: avoid; }

  pre {
    background: var(--panel-2);
    border: .25mm solid var(--rule);
    border-left: .8mm solid var(--yellow);
    border-radius: 1.2mm;
    padding: 4mm 4.5mm;
    margin: 0;
    overflow-x: hidden;
  }
  pre code {
    background: none; padding: 0;
    font-family: "IBM Plex Mono", monospace;
    font-size: 8.2pt; line-height: 1.5;
    color: var(--body);
  }

  figcaption {
    font-family: "IBM Plex Mono", monospace;
    font-size: 7.4pt; line-height: 1.5;
    color: var(--muted);
    text-align: center;
    margin-top: 2.4mm;
  }

  /* Stack: rows, so a long marginal note wraps in its gutter instead of
     running off the paper. module-guide learned this the expensive way -- one
     nowrap note made Chromium rescale every page in the document. */
  .stack { display: flex; flex-direction: column; gap: 2.2mm; }
  .stack .row {
    display: grid;
    grid-template-columns: 1fr 34mm;
    gap: 3mm;
    align-items: center;
  }
  .stack .layer {
    display: flex; align-items: center; justify-content: center;
    justify-self: center;
    border-radius: 1.4mm;
    padding: 3.2mm 5mm;
    font-family: "IBM Plex Mono", monospace;
    font-size: 8.2pt;
    color: #14110a;
    font-weight: 600;
    text-align: center;
  }
  .stack .note {
    font-family: "IBM Plex Mono", monospace;
    font-size: 7pt; line-height: 1.4;
    color: var(--muted);
    text-align: left;
  }
  .stack .row:nth-child(1) .layer { width: 46%; background: #ffe27a; }
  .stack .row:nth-child(2) .layer { width: 55%; background: #ffd23f; }
  .stack .row:nth-child(3) .layer { width: 64%; background: #ffab2e; }
  .stack .row:nth-child(4) .layer { width: 73%; background: #ff8c1a; }
  .stack .row:nth-child(5) .layer { width: 82%; background: #e0700f; }
  .stack .row:nth-child(6) .layer { width: 92%; background: #b8560a; }
  .stack .layer.emph { box-shadow: 0 0 0 .6mm var(--yellow); }


  /* ---------------- relational realizations ---------------- */
  /* Which geometry a relation may use is Rev. 3 §2's honesty table, not taste.
     `is-subset-of` gets nested regions because nesting *enforces* transitivity:
     you cannot draw C inside B inside A without also drawing C inside A, which
     is exactly what containment claims. A layered stack claims "sits on top of"
     and was false here. Relations with no realization built are reported by the
     engine, never approximated with a geometry that answers a different claim. */

  /* Rev. 3 §10 stage 2, the structural filter. Nested regions stay *honest* at
     any depth -- nesting is what containment claims -- but past a handful of
     levels the rings sit closer than a line of type and the labels collide.
     That is a legibility disqualification, not a truth one, so the answer is
     the next realization the honesty table permits for `is-subset-of`:
     indented layers. Reporting nothing would drop a figure that can be drawn.
     The threshold is uncalibrated -- Rev. 3 §13 has no principled line yet. */
  .indent { display: flex; flex-direction: column; gap: 1.6mm; }
  .indent .lvl { display: grid; grid-template-columns: 1fr 46mm; gap: 4mm; align-items: baseline; }
  .indent .bar {
    display: flex; align-items: center; gap: 2.4mm;
    padding: 1.8mm 3mm;
    border-left: 1mm solid;
  }
  .indent .nm { font-size: 9.6pt; }
  .indent .nt { font-size: 8.6pt; line-height: 1.4; }

  .euler { position: relative; width: 80mm; height: 80mm; margin: 0 auto; }
  .euler .region {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    border-radius: 50%;
    border: .3mm solid rgba(11,11,13,.45);
    display: flex;
    justify-content: center;
  }
  .euler .region .lbl {
    font-family: "IBM Plex Mono", monospace;
    font-size: 8pt;
    font-weight: 600;
    color: #14110a;
    /* Percentage margin resolves against the region's width, and the regions
       are square, so this places every label at the same relative depth --
       where the chord is wide enough to hold it. At the very top of the arc a
       long label spills outside its own circle and reads as belonging to none. */
    margin-top: 9%;
    max-width: 62%;
    line-height: 1.25;
    text-align: center;
  }
  .euler-key { display: flex; flex-direction: column; gap: 2.2mm; }
  .euler-key .row { display: flex; gap: 2.4mm; align-items: flex-start; }
  .euler-key .dot {
    flex: 0 0 2.6mm; height: 2.6mm; border-radius: 50%; margin-top: 1mm;
  }
  .euler-key .txt { font-size: 8pt; line-height: 1.4; color: var(--body); }
  .euler-key .txt b { font-family: "IBM Plex Mono", monospace; font-size: 7.6pt; color: var(--yellow); }
  .euler-wrap { display: grid; grid-template-columns: 1fr 52mm; gap: 6mm; align-items: center; }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 9.2pt;
    margin: 0;
  }
  th {
    font-family: "IBM Plex Mono", monospace;
    font-size: 7.4pt; font-weight: 600;
    letter-spacing: .16em; text-transform: uppercase;
    color: var(--orange);
    text-align: left;
    padding: 2.4mm 3mm;
    border-bottom: .35mm solid var(--rule-lit);
  }
  td {
    padding: 2.6mm 3mm;
    border-bottom: .2mm solid var(--rule);
    vertical-align: top;
    color: var(--body);
  }
  tr:nth-child(even) td { background: var(--panel); }

  .callout {
    background: var(--panel);
    border-left: .8mm solid var(--yellow);
    border-radius: 0 1.2mm 1.2mm 0;
    padding: 4mm 4.5mm;
    margin: 0 0 5mm;
    break-inside: avoid;
  }
  .callout.warning { border-left-color: var(--orange); background: #1c1409; }
  .callout .label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 7.4pt; font-weight: 600;
    letter-spacing: .2em; text-transform: uppercase;
    color: var(--orange);
    margin-bottom: 2mm;
  }
  .callout .title {
    font-family: "Space Grotesk", "Segoe UI", sans-serif;
    font-weight: 500; color: var(--yellow); margin-bottom: 1.6mm;
  }
  .callout p:last-child { margin-bottom: 0; }

  .example, .check {
    border: .25mm solid var(--rule-lit);
    border-radius: 1.2mm;
    padding: 4mm 4.5mm;
    margin: 0 0 5mm;
    break-inside: avoid;
  }
  .example .label, .check .label {
    font-family: "IBM Plex Mono", monospace;
    font-size: 7.4pt; font-weight: 600;
    letter-spacing: .2em; text-transform: uppercase;
    color: var(--amber-dim);
    margin-bottom: 2.4mm;
  }
  .example .title {
    font-family: "Space Grotesk", "Segoe UI", sans-serif;
    font-weight: 500; color: var(--yellow); margin-bottom: 2.4mm;
  }
  .example ol { margin-bottom: 0; }
  .check .q { color: var(--body); margin-bottom: 2mm; }
  .check .a { color: var(--amber-dim); }

  /* ---------------- gaps ---------------- */

  .gaps { break-before: page; }
  .gaps h2 { color: var(--orange); }
  .gap {
    border-top: .25mm solid var(--rule);
    padding: 4mm 0;
    break-inside: avoid;
  }
  .gap .topic {
    font-family: "Space Grotesk", "Segoe UI", sans-serif;
    font-weight: 500; color: var(--yellow); margin-bottom: 2mm;
  }
  .gap .k {
    font-family: "IBM Plex Mono", monospace;
    font-size: 7.2pt; letter-spacing: .14em; text-transform: uppercase;
    color: var(--orange);
  }

  .colophon {
    margin-top: 10mm;
    padding-top: 3mm;
    border-top: .25mm solid var(--rule);
    font-family: "IBM Plex Mono", monospace;
    font-size: 7pt; letter-spacing: .1em;
    color: var(--muted);
  }
</style>
</head>
<body>
{# Ring fills for the nested-regions realization: outermost first. #}
{% set RING_FILL = ["#b8560a","#e0700f","#ff8c1a","#ffab2e","#ffd23f","#ffe27a"] %}
{% set EMPH = "var(--yellow)" %}

{% if doc.cover %}
{% set c = doc.cover %}
<div class="cover">
  <svg class="grid" viewBox="0 0 210 297" preserveAspectRatio="none">
    <g fill="none" stroke="#4a3f22" stroke-width="0.18" opacity="0.75">
      <path d="M0 74 L210 74"/><path d="M0 150 L210 150"/><path d="M0 226 L210 226"/>
      <path d="M52 0 L52 297"/><path d="M105 0 L105 297"/><path d="M158 0 L158 297"/>
    </g>
    <g fill="none" stroke="#ff8c1a" stroke-width="0.3" opacity="0.55">
      <path d="M52 74 L105 74 L105 150 L158 150 L158 226"/>
    </g>
    <g fill="#ffd23f" opacity="0.8">
      <circle cx="52" cy="74" r="1.3"/><circle cx="105" cy="150" r="1.3"/>
      <circle cx="158" cy="226" r="1.3"/>
    </g>
  </svg>

  <div class="content">
    <div class="eyebrow">{{ c.eyebrow }}</div>
    <h1>{{ c.title }}{% if c.title_tail %} <span class="tail">{{ c.title_tail }}</span>{% endif %}</h1>
    {% if c.subtitle_lines %}
    <p class="subtitle">
      {% for line in c.subtitle_lines %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}
    </p>
    {% endif %}
    {% if c.chips %}
    <div class="chips">
      {% for chip in c.chips %}<span class="chip">{{ chip }}</span>{% endfor %}
    </div>
    {% endif %}
    {% if c.notes %}
    <div class="notes">
      {% for note in c.notes %}{{ note | inline }}{% if not loop.last %}<br>{% endif %}{% endfor %}
    </div>
    {% endif %}
  </div>

  <div class="footer">
    <div class="rule"></div>
    <div class="row">
      <span>{{ c.footer_left or "" }}</span>
      <span>{{ c.footer_right or "" }}</span>
    </div>
  </div>
</div>
{% endif %}

<table class="sheet">
<thead><tr><td></td></tr></thead>
<tfoot><tr><td></td></tr></tfoot>
<tbody><tr><td>

{% if doc.running_head_left or doc.running_head_right %}
<div class="runhead">
  <span>{{ doc.running_head_left or "" }}</span>
  <span>{{ doc.running_head_right or "" }}</span>
</div>
{% endif %}

{% if not doc.cover %}
<h1 style="font-family:'Space Grotesk',sans-serif;font-size:26pt;font-weight:700;
           color:var(--yellow);margin:0 0 3mm;line-height:1.1;">{{ doc.title }}</h1>
{% if doc.subtitle %}
<p style="font-size:12pt;color:var(--amber-dim);margin:0 0 8mm;">{{ doc.subtitle }}</p>
{% endif %}
{% endif %}

<div class="orient">
  <div class="row">
    <div class="k">Assumes</div>
    <div class="v">{{ doc.assumed_entry }}</div>
  </div>
  <div class="row">
    <div class="k">After this</div>
    <div class="v">{{ doc.target_capability }}</div>
  </div>
</div>

{% for section in doc.sections %}
<section>
  {% if section.eyebrow %}<div class="eyebrow-s">{{ section.eyebrow }}</div>{% endif %}
  <h2>{{ section.heading }}{% if section.heading_tail %} <span class="tail">{{ section.heading_tail }}</span>{% endif %}</h2>

  {% for b in section.blocks %}

    {% if b.kind == "prose" %}
      {% for para in b.text.split("\n\n") %}{% if para.strip() %}<p>{{ para.strip() | inline }}</p>{% endif %}{% endfor %}

    {% elif b.kind == "subhead" %}
      <div class="subhead">{{ b.label }}</div>

    {% elif b.kind == "heading" %}
      <h3>{{ b.text }}</h3>

    {% elif b.kind == "chips" %}
      <div class="body-chips">{% for chip in b['items'] %}<span class="chip">{{ chip }}</span>{% endfor %}</div>

    {% elif b.kind == "list" %}
      {% if b.ordered %}
      <ol>{% for item in b['items'] %}<li>{{ item | inline }}</li>{% endfor %}</ol>
      {% else %}
      <ul>{% for item in b['items'] %}<li>{{ item | inline }}</li>{% endfor %}</ul>
      {% endif %}

    {% elif b.kind == "relation" and b.relation == "is-subset-of" %}
      {% set NESTABLE = b.entities|length <= 6 %}
      <figure data-relation="{{ b.relation }}"
              data-realization="{{ "nested-regions" if NESTABLE else "indented-layers" }}">
      {% if NESTABLE %}
        <div class="euler-wrap">
          <div class="euler">
            {% for e in b.entities %}
            <div class="region"
                 style="width:{{ 100 - loop.index0 * (70 / (b.entities|length)) }}%;
                        height:{{ 100 - loop.index0 * (70 / (b.entities|length)) }}%;
                        background:{{ RING_FILL[loop.index0 % 6] }};
                        {% if e.emphasis %}box-shadow:0 0 0 .5mm {{ EMPH }};{% endif %}">
              <span class="lbl">{{ e.label }}</span>
            </div>
            {% endfor %}
          </div>
          <div class="euler-key">
            {% for e in b.entities %}
            <div class="row">
              <span class="dot" style="background:{{ RING_FILL[loop.index0 % 6] }}"></span>
              <span class="txt"><b>{{ e.label }}</b>{% if e.note %}<br>{{ e.note }}{% endif %}</span>
            </div>
            {% endfor %}
          </div>
        </div>
      {% else %}
        <div class="indent">
          {% for e in b.entities %}
          <div class="lvl">
            <div class="bar"
                 style="margin-left:{{ loop.index0 * 5 }}mm;
                        border-left-color:{{ RING_FILL[loop.index0 % 6] }};
                        background:{{ RING_FILL[loop.index0 % 6] }}33;
                        {% if e.emphasis %}box-shadow:0 0 0 .4mm {{ EMPH }};{% endif %}">
              <span class="nm">{{ e.label }}</span>
            </div>
            <span class="nt">{% if e.note %}{{ e.note }}{% endif %}</span>
          </div>
          {% endfor %}
        </div>
      {% endif %}
        {% if b.caption %}<figcaption>{{ b.caption }}</figcaption>{% endif %}
      </figure>

    {% elif b.kind == "relation" and b.relation == "precedes" %}
      {# Unchanged realization, deliberately: this change replaces the geometry's
         NAME with the relation's, it does not redesign the flow. #}
      <figure data-relation="{{ b.relation }}" data-realization="layered-flow">
        <div class="stack">
          {% for e in b.entities | reverse %}
          <div class="row">
            <div class="layer{% if e.emphasis %} emph{% endif %}">{{ e.label }}</div>
            <span class="note">{% if e.note %}{{ e.note }}{% endif %}</span>
          </div>
          {% endfor %}
        </div>
        {% if b.caption %}<figcaption>{{ b.caption }}</figcaption>{% endif %}
      </figure>

    {% elif b.kind == "code" %}
      <figure>
        <pre><code>{{ b.code }}</code></pre>
        {% if b.caption %}<figcaption>{{ b.caption }}</figcaption>{% endif %}
      </figure>

    {% elif b.kind == "table" %}
      <figure>
        <table>
          <thead><tr>{% for h in b.headers %}<th>{{ h }}</th>{% endfor %}</tr></thead>
          <tbody>
            {% for row in b.rows %}
            <tr>{% for cell in row %}<td>{{ cell | inline }}</td>{% endfor %}</tr>
            {% endfor %}
          </tbody>
        </table>
        {% if b.caption %}<figcaption>{{ b.caption }}</figcaption>{% endif %}
      </figure>

    {% elif b.kind == "callout" %}
      <div class="callout {{ b.tone }}">
        {% if b.label %}<div class="label">{{ b.label }}</div>{% endif %}
        {% if b.title %}<div class="title">{{ b.title }}</div>{% endif %}
        <p>{{ b.text | inline }}</p>
      </div>

    {% elif b.kind == "example" %}
      <div class="example">
        <div class="label">Worked example</div>
        <div class="title">{{ b.title }}</div>
        <ol>{% for step in b.steps %}<li>{{ step | denumber | inline }}</li>{% endfor %}</ol>
      </div>

    {% elif b.kind == "question" %}
      <div class="check">
        <div class="label">Check</div>
        <div class="q">{{ b.prompt | inline }}</div>
        <div class="a">{{ b.answer | inline }}</div>
      </div>

    {% else %}
      {# Rev. 3 instrument: a kind this template cannot draw used to render
         as nothing at all. Silence is the failure that hid the dropped chips
         blocks. Reported by the engine; invisible on paper. #}
      <div class="unrendered" data-kind="{{ b.kind }}"{% if b.kind == "relation" %} data-relation="{{ b.relation }}"{% endif %} style="display:none"></div>
    {% endif %}
  {% endfor %}
</section>
{% endfor %}

{% if doc.deliberate_omissions %}
<section class="gaps">
  <h2>Deliberately left out</h2>
  {% for gap in doc.deliberate_omissions %}
  <div class="gap">
    <div class="topic">{{ gap.topic }}</div>
    <div><span class="k">Consequence</span> &nbsp; {{ gap.consequence }}</div>
    <div><span class="k">Learn it before</span> &nbsp; {{ gap.when_to_learn }}</div>
  </div>
  {% endfor %}
</section>
{% endif %}

{% if colophon %}<div class="colophon">{{ colophon }}</div>{% endif %}

</td></tr></tbody>
</table>

</body>
</html>
